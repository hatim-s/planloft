{
  "name": "planloft",
  "version": "0.0.1",
  "description": "Hoist agent-written plans and docs into a global, themed, deployable store — organized by project, one-click copy-to-repo and deploy-for-review.",
  "packageManager": "pnpm@10.8.1",
  "type": "module",
  "license": "MIT",
  "bin": {
    "planloft": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "hooks",
    "commands",
    "themes",
    "templates",
    ".codex-plugin",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean --dts",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "nanoid": "^5.0.7",
    "picocolors": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
