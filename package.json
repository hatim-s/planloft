{
  "name": "planloft",
  "version": "0.0.1",
  "description": "Agent-native document compiler with one plan-writing skill, deep CLI help, and light/dark themed output.",
  "packageManager": "pnpm@10.8.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatim-s/planloft.git"
  },
  "homepage": "https://github.com/hatim-s/planloft#readme",
  "bugs": {
    "url": "https://github.com/hatim-s/planloft/issues"
  },
  "bin": {
    "planloft": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "hooks",
    "themes",
    "schemas",
    "templates",
    ".codex-plugin",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --clean --dts",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "prepack": "npm run build && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent",
    "cli",
    "documents",
    "markdown",
    "planning",
    "themes"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "nanoid": "^5.0.7",
    "picocolors": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
