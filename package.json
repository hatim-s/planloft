{
  "name": "planloft",
  "version": "0.2.4",
  "description": "Agent-native document compiler with focused authoring and customization skills, deep CLI help, and light/dark themed output.",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatim-s/planloft.git"
  },
  "homepage": "https://github.com/hatim-s/planloft#readme",
  "bugs": {
    "url": "https://github.com/hatim-s/planloft/issues"
  },
  "bin": {
    "planloft": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "themes",
    "schemas",
    "templates"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --clean --dts",
    "dev": "bun src/cli.ts",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts && bun test scripts/*.test.mjs _tests_/*.test.mjs",
    "test:installer": "node --test scripts/installer-matrix.test.mjs && node scripts/installer-matrix.mjs --contract",
    "test:public-api": "bun run build && node scripts/validate-public-api.mjs",
    "test:installer:live": "bun run build && node scripts/installer-matrix.mjs --live --quick --source local",
    "test:installer:release": "node scripts/installer-matrix.mjs --live --full --source all",
    "release:prepare": "bash scripts/release.sh prepare",
    "release:publish": "bash scripts/release.sh publish",
    "prepack": "bun run build && bun run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=18"
  },
  "keywords": [
    "agent",
    "cli",
    "documents",
    "markdown",
    "planning",
    "themes"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "nanoid": "^5.0.7",
    "picocolors": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "^8.20.0",
    "tsup": "^8.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
