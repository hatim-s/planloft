{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hatim-s/planlof/schemas/document.schema.json",
  "title": "Planloft document",
  "type": "object",
  "required": ["content"],
  "properties": {
    "version": { "const": 1, "default": 1 },
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1, "default": "plan" },
    "theme": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1, "default": "active" },
    "contentFormat": { "enum": ["md", "html"], "default": "md" },
    "content": { "type": "string" }
  },
  "additionalProperties": false
}
